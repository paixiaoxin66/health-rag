# ==================================
# Application
# ==================================

APP_NAME=health-rag
APP_ENV=development
DEBUG=true


# ==================================
# Embedding
# ==================================

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu


# ==================================
# RAG Retrieval
# ==================================

CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5


# ==================================
# Vector Store
# ==================================

VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store


# ==================================
# LLM
# ==================================

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=


# ==================================
# Hugging Face
# ==================================

HF_TOKEN=