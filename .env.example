# ==================================
# Application
# ==================================

APP_NAME=health-rag
APP_ENV=development
DEBUG=true


# ==================================
# Embedding
# ==================================

# 模型名（HF 缓存）：本地路径为空时使用
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 本地模型路径（优先）：下载模型后设为 models/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=

# 设备：cpu 或 cuda
EMBEDDING_DEVICE=cpu

# 离线模式：默认 true，禁止联网校验
EMBEDDING_LOCAL_ONLY=true


# ==================================
# RAG Retrieval
# ==================================

CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# Reranker
# ==================================
# 重排模型（CrossEncoder）：本地路径优先
RERANKER_MODEL=BAAI/bge-reranker-base

# 离线模式：默认 true
RERANKER_LOCAL_ONLY=true

# 召回候选数：先召回这么多，再重排取 TOP_K
RECALL_K=20


# ==================================
# Vector Store
# ==================================

VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/vector_store


# ==================================
# LLM
# ==================================

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ==================================
# Hugging Face
# ==================================

HF_TOKEN=


# ==================================
# Logging
# ==================================

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志文件（JSON Lines 结构日志，5MB 轮转 × 5 份）
LOG_FILE=logs/app.log